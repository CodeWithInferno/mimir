# Text is stored with LF and checked out with LF on every platform: the launcher is a shell script, scene line
# numbers appear in diagnostics, and frame hashes must not depend on the checkout.
* text=auto eol=lf

bin/mimir        text eol=lf
# the Windows launcher is read by cmd, which wants CRLF
*.cmd            text eol=crlf
*.sh             text eol=lf
*.ts             text eol=lf
*.js             text eol=lf
*.mjs            text eol=lf
*.json           text eol=lf
*.md             text eol=lf
*.yml            text eol=lf
*.css            text eol=lf
*.html           text eol=lf
bun.lock         text eol=lf

# binary assets (only embedded fonts are expected in this repository; no images or video)
*.woff2          binary
*.woff           binary
*.ttf            binary
*.otf            binary
*.png            binary
*.jpg            binary
*.mp4            binary

# generated by `bun scripts/build.ts`; tracked on purpose, collapsed in diffs and left out of language statistics
src/_generated/** linguist-generated=true
types/mimir.d.ts  linguist-generated=true
bun.lock          linguist-generated=true

