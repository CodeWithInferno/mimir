# dependencies and build output
node_modules/
dist/
# written by scripts/build.ts (the CLI, `bun run typecheck` and `bun test` build them when they are missing)
src/_generated/
types/mimir.d.ts
types/mimir.module.d.ts

# what the CLI writes (default output of `mimir shot` is .mimir/shots/<scene>)
.mimir/
shots/
out/

# internal process material: research, reviews, plans, design competition, look-dev, hand-built prototypes.
# It stays on the maintainers' machines and is never published (docs/OSS-HYGIENE.md, "Repository").
internal/
tmp/

# no generated media in git
*.mp4
*.mov
*.webm
*.gif
# the clips the README shows: each is rebuilt from a tracked scene (examples/generated, examples/quick-*) with `mimir export --mp4`
!docs/media/*.gif
!docs/media/*.mp4

# local
*.log
.DS_Store
Thumbs.db
.env
.env.*
.idea/
.vscode/

# Internal process material that still lies in a maintainer's working tree until it has been moved to internal/
# (docs/OSS-HYGIENE.md, "Repository": research, reviews, plans, the design competition, look-dev, hand-built
# prototypes). Ignored so that `git add -A` can never publish it; `bun run hygiene` reports any of it that is tracked.
docs/research/
docs/reviews/
docs/plans/
design/
lookdev/
sample/
task_plan.md
findings.md
progress.md
# internal process notes (never published; see docs/OSS-HYGIENE.md)
docs/research/
docs/reviews/
docs/plans/
task_plan.md
findings.md
progress.md
