{
  "name": "mimir-explain",
  "version": "0.1.0",
  "description": "Ask how something works; get a narrated, animated, interactive explanation from one model call. Scenes are short scripts with no positions, sizes or timings.",
  "keywords": [
    "explainer",
    "animation",
    "simulation",
    "visualization",
    "interactive",
    "diagram",
    "3d",
    "threejs",
    "svg",
    "cli",
    "agent",
    "ai-native",
    "education",
    "bun"
  ],
  "license": "MIT",
  "author": "CodeWithInferno",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeWithInferno/mimir.git"
  },
  "homepage": "https://github.com/CodeWithInferno/mimir#readme",
  "bugs": {
    "url": "https://github.com/CodeWithInferno/mimir/issues"
  },
  "type": "module",
  "bin": {
    "mimir": "bin/mimir",
    "mimir-explain": "bin/mimir"
  },
  "module": "dist/mimir.js",
  "types": "types/mimir.d.ts",
  "exports": {
    ".": {
      "types": "./types/mimir.d.ts",
      "default": "./dist/mimir.js"
    },
    "./3d": "./dist/mimir.3d.js",
    "./check": "./dist/mimir.check.js"
  },
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "bench/",
    "bin/",
    "dist/",
    "docs/CONFIG.md",
    "docs/EXTENDING.md",
    "docs/OSS-HYGIENE.md",
    "docs/QUICK.md",
    "docs/STATUS.md",
    "docs/agents.md",
    "docs/cli.md",
    "docs/getting-started.md",
    "docs/topics/",
    "examples/",
    "skills/",
    "src/",
    "tsconfig.json",
    "types/"
  ],
  "engines": {
    "bun": ">=1.3.11"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "barrels": "bun scripts/build.ts --barrels",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "typecheck": "bun scripts/build.ts --barrels --quiet && tsc --noEmit -p .",
    "test:e2e": "bun test tests/e2e",
    "offline-proof": "bun scripts/offline-proof.ts",
    "hygiene": "bun scripts/hygiene.ts",
    "hygiene:strict": "bun scripts/hygiene.ts --strict",
    "prepack": "bun scripts/build.ts"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2"
  }
}
